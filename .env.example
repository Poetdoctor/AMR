# Community section (phase 6). Copy to .env.local for local development, and set
# the same two values in Netlify's environment variables for the deployed site.
#
# Both of these are PUBLIC. Vite inlines every VITE_-prefixed variable into the
# shipped JavaScript bundle, and that is correct here: the anon key is designed
# to be public, and row-level security is what protects the data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ─────────────────────────────────────────────────────────────────────────────
# NEVER put these here, and never give them a VITE_ prefix. They live only in
# Supabase's Edge Function secrets (Project Settings → Edge Functions → Secrets):
#
#   SUPABASE_SECRET_KEY         (sb_secret_...) bypasses row-level security
#                               entirely. Supabase injects this into deployed
#                               functions automatically — you never paste it.
#   ANTHROPIC_API_KEY           billed to the team
#   FINGERPRINT_SALT            makes the rate-limit hashes non-reversible
#   DISCORD_WEBHOOK_URL         the daily sweep nudge
#   SITE_ORIGIN                 https://your-site.netlify.app, for CORS
#
# A VITE_ prefix on the service role key would publish read-write access to
# every comment, removed ones included, to anyone who opens developer tools.
