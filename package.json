{
  "name": "amr-psychosocial-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "iGEM UBC Human Practices \u2014 psychosocial impact of antimicrobial resistance",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node scripts/smoke.mjs",
    "test:content": "node scripts/test-content.mjs",
    "test:db": "node scripts/test-db.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:locales": "node scripts/test-locales.mjs",
    "build:fonts": "node scripts/build-narrative-fonts.mjs",
    "prerender": "node scripts/prerender.mjs",
    "test:prerender": "node scripts/test-prerender.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/noto-sans-gurmukhi": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "@supabase/supabase-js": "^2.112.4",
    "decap-cms-app": "^3.15.1",
    "marked": "^18.0.11",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "puppeteer-core": "^25.8.0",
    "subset-font": "^2.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
